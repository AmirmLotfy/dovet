# Non-secret configuration example; doctor must resolve required empty fields.
# No AWS keys, OpenAI session cookies or passwords belong in this file.
DOVET_ENV=development
DOVET_HOST=127.0.0.1
DOVET_PORT=4317
DOVET_CLOUD_ENABLED=false
DOVET_ALLOW_PAID_PROBES=false
DOVET_AWS_REGION=
DOVET_AWS_PROFILE=
DOVET_BEDROCK_MODEL_ID=
DOVET_AGENTCORE_RUNTIME_ARN=
DOVET_CODE_INTERPRETER_ID=
DOVET_PUBLIC_DEMO_ENABLED=false
DOVET_PUBLIC_SITE_URL=
DOVET_SUPERVISOR_MAX_TURNS=6
DOVET_SUPERVISOR_TIMEOUT_SECONDS=45
DOVET_LOG_LEVEL=info
